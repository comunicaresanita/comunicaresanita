# Copia questo file in "secrets.env" (NON va nel repository né in chat), compila i valori e caricalo con:
#   npx supabase secrets set --env-file docs/migrazione/secrets.env
# Quelli che iniziano per SUPABASE_ li imposta Supabase da solo.

RESEND_API_KEY=
EMAIL_FROM=ComuniCARE <prenotazioni@comunicaresanita.it>
# EMAIL_REPLY_TO=

# Firma dei link Conferma/Rifiuta nelle email. Un valore nuovo, lungo e casuale (es. 40+ caratteri).
BOOKING_ACTION_SECRET=
# Segreto con cui il cron chiama le funzioni. Lo stesso valore va in 04-cron.sql.
CRON_SECRET=

APP_URL=https://comunicaresanita.it
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Assistente digitale: chiave Anthropic (console.anthropic.com). Senza chiave l'assistente risulta spento.
ANTHROPIC_API_KEY=
